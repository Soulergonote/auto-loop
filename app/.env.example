# Copier en .env.local puis remplir.

# LeverageExecutor déployé, un par marché (identifiants dans src/config.ts : ethereum, ethereum-prime, arbitrum,
# base, avalanche, optimism, polygon, bnb). Marché absent = pas encore déployé : l'interface calcule tout et
# montre la transaction, mais ne propose pas de la signer. Exemple : {"base":"0x…","arbitrum":"0x…"}
VITE_EXECUTORS=
# Ancienne variable, toujours lue comme l'adresse sur Base.
VITE_EXECUTOR_ADDRESS=

# RPC par chaîne : VITE_RPC_URL_<chainId> (ex. VITE_RPC_URL_42161 pour Arbitrum). Vide = PublicNode, puis le RPC
# public par défaut de la chaîne. VITE_RPC_URL vaut pour Base.
# Pour un fork local : anvil --fork-url https://mainnet.base.org --chain-id 8453, puis http://127.0.0.1:8545
VITE_RPC_URL=

# Cotations : auto (API réelles, repli sur un devis simulé si elles ne répondent pas), live, ou mock.
VITE_QUOTE_MODE=auto

# Routes Velora : DEX autorisés ou exclus (noms Velora, virgules). Vide = tout. Sur fork local, garder
# les AMM classiques, les DEX à prix d'oracle y revertent (voir README) :
# VITE_VELORA_INCLUDE_DEXS=UniswapV3,UniswapV4,AerodromeSlipstream,AerodromeSlipstreamFactory3,PancakeswapV3
VITE_VELORA_INCLUDE_DEXS=
VITE_VELORA_EXCLUDE_DEXS=

# Clés API (0x et 1inch, désactivés pour l'instant), lues uniquement par le serveur de dev de Vite (proxy /api/*), jamais envoyées au navigateur.
ZEROX_API_KEY=
ONEINCH_API_KEY=
